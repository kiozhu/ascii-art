# ===========================================
# ASCII Overlay - Environment Config
# ===========================================

# --- Server Config ---
PORT=5050
HOST=0.0.0.0

# --- TikTok Account ---
TIKTOK_USERNAME=
TIKTOK_ROOM_ID=
TIKTOK_COOKIE=

# --- OBS Config ---
OBS_WIDTH=1920
OBS_HEIGHT=1080

# --- Overlay Visual ---
MATRIX_RAIN_OPACITY=0.15
OVERLAY_BG_COLOR=000000
NEON_COLOR=00ff41
EVENT_DISPLAY_DURATION=5

# --- Display Defaults ---
DEFAULT_MANUAL_TEXT=ASCII OVERLAY ACTIVE
AUTO_START_TIKTOK=false

# --- Telegram Bot Trigger ---
# Enable/disable telegram trigger
TELEGRAM_ENABLED=false

# Bot Token dari @BotFather (wajib diisi kalau TELEGRAM_ENABLED=true)
# Cara dapat:
#   1. Buka Telegram → cari @BotFather
#   2. Kirim /newbot
#   3. Ikuti instruksi → dapat token seperti 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=

# Chat ID yang boleh trigger command (security)
# Kosongkan = semua orang bisa pakai bot
# Cara dapat:
#   1. Kirim pesan ke @userinfobot → dapat chat ID
#   2. Atau ke @getidsbot
#   3. Atau kirim /start ke @RawDataBot
TELEGRAM_ADMIN_CHAT_ID=

# Prefix command (misal /ascii)
# Kalau kosong, bot accept semua text langsung
TELEGRAM_COMMAND_PREFIX=ascii